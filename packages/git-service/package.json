{
  "name": "@gitstudio/git-service",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Host-agnostic Git data layer for GitStudio: spawned git CLI process pool + streaming log/blame/ref/object providers. No vscode import.",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "tsx --import ../../scripts/test/hermetic-git.mjs --test \"test/**/*.test.ts\"",
    "check-types": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@gitstudio/ai": "*",
    "@gitstudio/engine": "*",
    "@gitstudio/host-bridge": "*",
    "@gitstudio/l10n": "*",
    "@vscode/l10n": "^0.0.18"
  }
}
