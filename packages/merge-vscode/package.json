{
  "name": "@gitstudio/merge-vscode",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "The VS Code host glue for the merge experience GitStudio and Merge Studio share: merge editor, conflicts dashboard, routing and the diff panel, parameterised by a MergeProduct.",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "tsx --import ../../scripts/test/hermetic-git.mjs --import ./test/hermetic.ts --test \"test/**/*.test.ts\"",
    "check-types": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@gitstudio/engine": "*",
    "@gitstudio/git-service": "*",
    "@gitstudio/host-bridge": "*",
    "@gitstudio/l10n": "*",
    "@gitstudio/webview-ui": "*",
    "@vscode/l10n": "^0.0.18"
  },
  "devDependencies": {
    "@types/vscode": "1.78.0"
  }
}
